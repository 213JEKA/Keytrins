<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="@color/text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Торговля, стратегия, API и диагностика"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Торговля"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/liveSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Реальная торговля"
                android:textColor="@color/text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/riskInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Риск USDT"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />

                <EditText
                    android:id="@+id/universeInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Universe"
                    android:inputType="number"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Стратегия"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Crypto-only • H1 EMA50/200 + ADX≥22 • M15 pullback + confirmation\nPrimary: -0.20R + слом → закрыть 85% • -0.35R → закрыть остаток\nHEDGE: при -0.15 ENTRY ATR открыть 100% встречной позиции • fail-safe не позже -0.15R • аварийный SL 0.20 ATR\nЕсли primary снова выходит в расчётный net + → hedge закрыть reduce-only\nЕсли adverse движение продолжается после partial/full primary → hedge остаётся и ведётся $0.50/$0.50 • TP нет"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bybit API"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="API key"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/apiSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="API secret"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <Switch
                android:id="@+id/testnetSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Testnet"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Read + Derivatives Trade. Withdraw не включать. Secret хранится локально."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/accent"
            android:text="СОХРАНИТЬ НАСТРОЙКИ"
            android:textColor="#151008"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/doctorApiButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ПРОВЕРКА API" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/logButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ЖУРНАЛ" />
        </LinearLayout>

        <Button
            android:id="@+id/resetIncomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СБРОСИТЬ ОТСЧЁТ ДОХОДА" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="НАЗАД" />

    </LinearLayout>
</ScrollView>
