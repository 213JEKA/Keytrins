<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки API"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bybit V5 • ключи хранятся только на устройстве"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API key"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/apiSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="API secret"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Разрешения: Read + Derivatives Trade. Withdraw НЕ давать. Secret шифруется через Android Keystore."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/testnetSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Testnet"
                android:textColor="@color/text" />
        </LinearLayout>

        <Button
            android:id="@+id/saveApiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="СОХРАНИТЬ API" />

        <Button
            android:id="@+id/doctorApiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ПРОВЕРИТЬ ПОДКЛЮЧЕНИЕ" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="НАЗАД" />

    </LinearLayout>
</ScrollView>
