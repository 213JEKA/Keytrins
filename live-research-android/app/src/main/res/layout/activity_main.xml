<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OKX INVERSE v0.1.0"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LONG сигнал → SHORT • SHORT сигнал → LONG"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Остановлен"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OKX V5 API" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp"/>

            <EditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="API key"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/apiSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API secret"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/apiPassphrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API passphrase"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ключ OKX: Read + Trade. Withdraw не разрешать. Key/Secret/Passphrase хранятся локально через Android Keystore. Для торговли нужен One-Way / net_mode."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/testnetSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Demo / simulated trading"
                android:textColor="@color/text" />

            <Switch
                android:id="@+id/liveSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="РЕАЛЬНАЯ ТОРГОВЛЯ"
                android:textColor="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Стратегия" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/riskInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:hint="Риск USDT" android:inputType="numberDecimal" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <EditText android:id="@+id/universeInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:hint="Активов" android:inputType="number" android:textColor="@color/text" android:textColorHint="@color/muted"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Сигналы ранней версии Bybit без изменений • исполнение инвертировано • исходный SL зеркалится под фактическую позицию • +1.5R → безубыток + комиссии/спред/2 тика • дальше стоп не подтягивается • TP нет • сокращений и hedge нет"
                android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button android:id="@+id/saveButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Сохранить"/>
            <Button android:id="@+id/doctorButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Проверка"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="СТАРТ"/>
            <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="СТОП"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Состояние" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:id="@+id/metricsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="—" android:textColor="@color/text" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Журнал" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:fontFamily="monospace" android:text="Готов." android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
